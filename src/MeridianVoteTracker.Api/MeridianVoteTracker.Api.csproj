<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <UserSecretsId>meridian-vote-tracker-api</UserSecretsId>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <!-- Measured on the 962k-row historic import: Server GC reserved ~590 MB, Workstation GC stayed flat at ~110 MB.
         A single-instance internal service benefits more from a predictable footprint. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Swashbuckle.AspNetCore" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MeridianVoteTracker.Application\MeridianVoteTracker.Application.csproj" />
    <ProjectReference Include="..\MeridianVoteTracker.Infrastructure\MeridianVoteTracker.Infrastructure.csproj" />
  </ItemGroup>

</Project>
